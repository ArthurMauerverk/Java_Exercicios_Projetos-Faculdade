	public String busca(ArrayList<String> lista, String nome_p) {
		
		Iterator i = lista.iterator();
		
		String nome;
		int contador = 0;
		
		while(i.hasNext()) {
			
			nome = (String) i.next();
			
			if (nome.equalsIgnoreCase(nome_p)) {
				
				contador++;
				
			}
			
		}
		
		if (contador == 1) {
			
			return "O nome está presente na lista";
			
		}else if(contador > 1) {
			
			return "O nome está presente na lista " + contador + " vezes";
			
		}else {
			
			return "O nome não está presente na lista.";
			
		}
		
	}

